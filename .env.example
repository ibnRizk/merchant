# Copy to `.env` and fill in. `.env` is bundled as a Flutter asset and is
# readable by anyone who unzips the APK/IPA — never put a private key here.
APP_NAME=
BASE_URL=
ENABLE_NETWORK_LOGS=false
CONNECT_TIMEOUT_MS=30000
RECEIVE_TIMEOUT_MS=30000

# Realtime (Pusher protocol). Leave PUSHER_APP_KEY empty to disable realtime;
# screens then refresh by polling only. The app key is public; never put the
# Pusher secret here. Use PUSHER_APP_CLUSTER for Pusher Channels, or
# PUSHER_HOST/PUSHER_PORT/PUSHER_SCHEME for a self-hosted server (Reverb, Soketi).
PUSHER_APP_KEY=
PUSHER_APP_CLUSTER=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=wss
