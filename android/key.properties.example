# Copy to android/key.properties (git-ignored) and fill in.
# storeFile is relative to the android/ folder, or an absolute path.
# android/.gitignore ignores *.jks there; better still, keep the keystore
# outside the repo, e.g. storeFile=C:/Users/<you>/keys/ssm-merchant-upload.jks
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
